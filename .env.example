# Elvora LeadGen — Umgebungsvariablen
# Kopiere diese Datei nach .env und fülle die Werte aus.

# Datenbank-Verschlüsselung (PFLICHT)
# 64 Hex-Zeichen = 32 Byte Raw-Key für SQLCipher.
# Generieren: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ELVORA_DB_KEY=

# Optional: Bearer-Token für Cron-Endpoints (/api/cron/*)
CRON_SECRET=
